{
  "name": "@recording-to-data/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file=.env src/server.ts",
    "send-form": "node --env-file=.env scripts/send-form.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:e2e": "node --test --test-timeout=600000 \"src/e2e/*.e2e.ts\"",
    "preflight": "node --env-file=.env scripts/preflight.ts",
    "local-e2e": "node --env-file=.env scripts/local-e2e.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.10.0"
  }
}
