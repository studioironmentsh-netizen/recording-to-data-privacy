NODE_ENV=development
PORT=3000

WHATSAPP_VERIFY_TOKEN=replace_with_local_value
WHATSAPP_ACCESS_TOKEN=replace_with_local_value
WHATSAPP_APP_SECRET=replace_with_local_value
WHATSAPP_PHONE_NUMBER_ID=replace_with_local_value
ALLOWED_TECHNICIAN_WA_IDS=15550000000
GRAPH_API_VERSION=v23.0
DATA_DIR=./data
MEDIA_MAX_BYTES=16777216
MEDIA_KEEP_SECONDS=0

# --- Voice pipeline (local STT + Claude). Disabled unless PIPELINE_ENABLED=true. ---
PIPELINE_ENABLED=false
STT_MODEL_DIR=C:\absolute\path\to\ivrit-ai__whisper-large-v3-turbo-ct2
# STT_PYTHON_EXE defaults to apps/api/python/.venv-stt/Scripts/python.exe
# Extraction is MOCK unless every live gate below is satisfied (see docs/experiments/E2E-VOICE-01/README.md):
EXTRACTOR_MODE=mock
# ANTHROPIC_API_KEY=            (new key only; the previously exposed key must be revoked)
# ANTHROPIC_KEY_ROTATION_CONFIRMED=yes
# ANTHROPIC_LIVE_APPROVAL=      (exact approval phrase; only after Moshe approves budget)

# --- Safe test mode (SPK-META-02) ---
# OUTBOUND_ENABLED: the ONLY switch that lets this process send WhatsApp messages (ACK, failure notices, forms, outbox retries,
# button replies, scripts/send-form.ts). Absent, empty or anything other than the exact value `true` => OFF. Inbound processing
# (download -> STT -> Claude -> validation -> saved form) is unaffected. Forms saved while OFF stay queued in the outbox and will be
# delivered by the next start with OUTBOUND_ENABLED=true (if still inside the 24 h window).
OUTBOUND_ENABLED=false
# Read-only local form inspector (GET /local/forms, /local/forms/<id>) on its OWN loopback port; never served on the webhook port/tunnel.
LOCAL_INSPECT_ENABLED=false
LOCAL_INSPECT_PORT=3001
# ACK_ENABLED=false  (only relevant when OUTBOUND_ENABLED=true)

# --- Delivery diagnosis (SPK-META) ---
# INBOUND_MEDIA_ONLY=true: a voice message from an allowlisted sender is downloaded from Meta and the job STOPS before STT/Claude/forms
# (log events: media_download_succeeded, media_only_stopped_before_stt). Forces outbound OFF, builds no Claude client, never starts STT.
# Needs PIPELINE_ENABLED=true for these logs. Only the exact value `true` enables it; default false.
INBOUND_MEDIA_ONLY=false
