NODE_ENV=development
PORT=3000

WHATSAPP_VERIFY_TOKEN=replace_with_local_value
WHATSAPP_ACCESS_TOKEN=replace_with_local_value
WHATSAPP_APP_SECRET=replace_with_local_value
WHATSAPP_PHONE_NUMBER_ID=replace_with_local_value
ALLOWED_TECHNICIAN_WA_IDS=15550000000
GRAPH_API_VERSION=v23.0
DATA_DIR=./data
MEDIA_MAX_BYTES=16777216
MEDIA_KEEP_SECONDS=0

# --- Voice pipeline (local STT + Claude). Disabled unless PIPELINE_ENABLED=true. ---
PIPELINE_ENABLED=false
STT_MODEL_DIR=C:\absolute\path\to\ivrit-ai__whisper-large-v3-turbo-ct2
# STT_PYTHON_EXE defaults to apps/api/python/.venv-stt/Scripts/python.exe
# Extraction is MOCK unless every live gate below is satisfied (see docs/experiments/E2E-VOICE-01/README.md):
EXTRACTOR_MODE=mock
# ANTHROPIC_API_KEY=            (new key only; the previously exposed key must be revoked)
# ANTHROPIC_KEY_ROTATION_CONFIRMED=yes
# ANTHROPIC_LIVE_APPROVAL=      (exact approval phrase; only after Moshe approves budget)
